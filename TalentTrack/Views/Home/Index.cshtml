@model TalentTrack.Models.DashboardViewModel

@{
    ViewData["Title"] = "Recruiter Dashboard";
    string userName = Context.Session.GetString("UserName") ?? "Recruiter";
}

<div class="container-fluid">

    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Welcome back, @userName 👋</h2>
            <p class="text-muted mb-0">Here is your recruitment overview for today.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Jobs" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Post New Job
            </a>
            <a asp-controller="Interview" asp-action="Create" class="btn btn-outline-primary">
                <i class="bi bi-calendar-plus me-1"></i> Schedule Interview
            </a>
        </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 tt-stat-card" style="background:linear-gradient(135deg,#6366F1,#8B5CF6);color:white;">
                <div class="d-flex align-items-center gap-3">
                    <div class="tt-icon-bubble" style="background:rgba(255,255,255,0.2);width:48px;height:48px;">
                        <i class="bi bi-briefcase-fill text-white"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-2">@Model.TotalJobs</div>
                        <div class="opacity-80 small">Total Jobs</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 tt-stat-card" style="background:linear-gradient(135deg,#10B981,#06B6D4);color:white;">
                <div class="d-flex align-items-center gap-3">
                    <div class="tt-icon-bubble" style="background:rgba(255,255,255,0.2);width:48px;height:48px;">
                        <i class="bi bi-people-fill text-white"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-2">@Model.TotalCandidates</div>
                        <div class="opacity-80 small">Candidates</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 tt-stat-card" style="background:linear-gradient(135deg,#F59E0B,#F97316);color:white;">
                <div class="d-flex align-items-center gap-3">
                    <div class="tt-icon-bubble" style="background:rgba(255,255,255,0.2);width:48px;height:48px;">
                        <i class="bi bi-calendar-event-fill text-white"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-2">@Model.TotalInterviews</div>
                        <div class="opacity-80 small">Interviews</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 tt-stat-card" style="background:linear-gradient(135deg,#EF4444,#EC4899);color:white;">
                <div class="d-flex align-items-center gap-3">
                    <div class="tt-icon-bubble" style="background:rgba(255,255,255,0.2);width:48px;height:48px;">
                        <i class="bi bi-lightning-charge-fill text-white"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-2">@Model.OpenPositions</div>
                        <div class="opacity-80 small">Open Positions</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TODAY'S INTERVIEW SCHEDULE -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left:4px solid #10B981!important;">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-calendar-day-fill me-2 text-success"></i>
                Today's Interview Schedule
            </h5>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                    @DateTime.Now.ToString("dd MMM yyyy")
                </span>
                <a asp-controller="Interview" asp-action="Create" class="btn btn-sm btn-success">
                    <i class="bi bi-plus me-1"></i>Schedule
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            @if (Model.TodayInterviews != null && Model.TodayInterviews.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var iv in Model.TodayInterviews)
                    {
                        <div class="tt-schedule-card today">
                            <div class="row align-items-center g-3">
                                <div class="col-auto">
                                    <div class="tt-avatar" style="width:44px;height:44px;font-size:1rem;">
                                        @(iv.Candidate?.Name?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="fw-bold">@(iv.Candidate?.Name ?? "N/A")</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-briefcase me-1"></i>@(iv.Job?.JobTitle ?? "N/A")
                                    </div>
                                </div>
                                <div class="col-auto text-center">
                                    <div class="text-muted small">Interviewer</div>
                                    <div class="fw-medium">
                                                                        @if (iv.Interviewers.Any())
                                        {
                                            <i class="bi bi-person-check me-1 text-success"></i>
                                            <span>@string.Join(", ", iv.Interviewers.Select(u => u.Name))</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning small"><i class="bi bi-person-x me-1"></i>Not Assigned</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-auto text-center">
                                    <div class="text-muted small">Time</div>
                                    <div class="fw-medium">
                                        <i class="bi bi-clock me-1 text-primary"></i>@iv.InterviewDate.ToString("hh:mm tt")
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(iv.Mode))
                                {
                                    <div class="col-auto text-center">
                                        <div class="text-muted small">Mode</div>
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@iv.Mode</span>
                                    </div>
                                }
                                <div class="col-auto">
                                    @if (iv.Status == "Confirmed" || iv.Status == "Completed")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@iv.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">@iv.Status</span>
                                    }
                                </div>
                                <div class="col-auto">
                                    <a asp-controller="Interview" asp-action="Edit" asp-route-id="@iv.InterviewId"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-calendar-x text-muted" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-2 mb-2">No interviews scheduled for today.</p>
                    <a asp-controller="Interview" asp-action="Create" class="btn btn-sm btn-success">
                        <i class="bi bi-calendar-plus me-1"></i>Schedule an Interview
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Recent Jobs Section -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-briefcase me-2 text-primary"></i>Recent Jobs</h5>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-sm btn-light text-primary fw-medium">View All <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Job Title</th>
                            <th>Skills Required</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentJobs != null && Model.RecentJobs.Any())
                        {
                            @foreach (var job in Model.RecentJobs)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">@job.JobTitle</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">@job.Skills</span></td>
                                    <td><i class="bi bi-geo-alt me-1 text-muted"></i>@job.Location</td>
                                    <td>
                                        @if (job.Status == "Active" || job.Status == "Open" || job.Status == "Hiring")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@job.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">@job.Status</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Jobs" asp-action="Edit" asp-route-id="@job.JobId" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No recent jobs. <a asp-controller="Jobs" asp-action="Create" class="text-primary fw-medium">Post a Job</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2-Column: Recent Candidates & Upcoming Interviews -->
    <div class="row g-4">
        <!-- Recent Candidates -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-success"></i>Recent Candidates</h5>
                    <a asp-controller="Candidates" asp-action="Index" class="btn btn-sm btn-light text-success fw-medium">View All <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Name</th>
                                    <th>Skills</th>
                                    <th>Exp.</th>
                                    <th class="pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentCandidates != null && Model.RecentCandidates.Any())
                                {
                                    @foreach (var c in Model.RecentCandidates)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center fw-bold" style="width:30px;height:30px;font-size:12px;">
                                                        @(c.Name?.Substring(0,1).ToUpper() ?? "?")
                                                    </div>
                                                    @(c.Name ?? "N/A")
                                                </div>
                                            </td>
                                            <td><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">@(c.Skills ?? "N/A")</span></td>
                                            <td>@(c.Experience.HasValue ? $"{c.Experience} Yrs" : "N/A")</td>
                                            <td class="pe-4 text-end">
                                                <a asp-controller="Candidates" asp-action="Edit" asp-route-id="@c.CandidateId" class="btn btn-sm btn-outline-success"><i class="bi bi-pencil"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center py-4 text-muted">No candidates. <a asp-controller="Candidates" asp-action="Create" class="text-success">Add one</a></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Interviews -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-warning"></i>Upcoming Interviews</h5>
                    <a asp-controller="Interview" asp-action="Index" class="btn btn-sm btn-light text-warning fw-medium">View All <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Candidate</th>
                                    <th>Interviewer</th>
                                    <th>Date</th>
                                    <th class="pe-4 text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.UpcomingInterviews != null && Model.UpcomingInterviews.Any())
                                {
                                    @foreach (var iv in Model.UpcomingInterviews)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium">
                                                <div>@(iv.Candidate?.Name ?? "N/A")</div>
                                                <small class="text-muted">@(iv.Job?.JobTitle ?? "")</small>
                                            </td>
                                            <td>
                                                @if (iv.Interviewers.Any())
                                                {
                                                    <span><i class="bi bi-person-check me-1 text-success"></i>@string.Join(", ", iv.Interviewers.Select(u => u.Name))</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning small"><i class="bi bi-person-x me-1"></i>Unassigned</span>
                                                }
                                            </td>
                                            <td>
                                                <div>@iv.InterviewDate.ToString("dd MMM")</div>
                                                <small class="text-muted">@iv.InterviewDate.ToString("hh:mm tt")</small>
                                            </td>
                                            <td class="pe-4 text-end">
                                                @if (iv.Status == "Confirmed" || iv.Status == "Completed")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">@iv.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">@iv.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center py-4 text-muted">No upcoming interviews. <a asp-controller="Interview" asp-action="Create" class="text-warning">Schedule one</a></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>