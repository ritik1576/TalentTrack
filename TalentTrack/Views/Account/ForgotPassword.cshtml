@{
    ViewData["Title"] = "Forgot Password";
    ViewData["HideLayoutNav"] = true;
}

<div class="tt-login-container">
    <div class="tt-login-card" style="max-width: 800px;">
        <div class="row g-0">

            <!-- Left Banner Side -->
            <div class="col-md-5 tt-login-banner text-white">
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo.png" alt="TalentTrack Logo" class="rounded-circle bg-white p-1" style="width: 48px; height: 48px; object-fit: cover;" />
                        <span class="fs-2 fw-bold text-white tracking-tight">TalentTrack</span>
                    </div>
                    <h3 class="fw-bold mb-3">Recover Password</h3>
                    <p class="opacity-90 leading-relaxed small">
                        Enter your registered email address and we will help you reset your account password.
                    </p>
                </div>
            </div>

            <!-- Right Form Side -->
            <div class="col-md-7 tt-login-form-wrapper">
                <div class="mb-4">
                    <h3 class="fw-bold text-white mb-1">Forgot Password</h3>
                    <p class="text-secondary small">Identify your account email to proceed.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="mb-4">
                        <label class="form-label text-light fw-medium small">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-secondary border-opacity-50 text-secondary">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input type="email" name="email" class="form-control" placeholder="name@company.com" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 mb-3 fw-bold">
                        Verify Email &amp; Proceed <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none small fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Back to Login Page
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
