@{
    ViewData["Title"] = "Sign In";
    ViewData["HideLayoutNav"] = true;
}

<div class="tt-login-container">
    <div class="tt-login-card">
        <div class="row g-0">

            <!-- Left Banner Side -->
            <div class="col-lg-6 tt-login-banner text-white">
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo.png" alt="TalentTrack Logo" class="rounded-circle bg-white p-1" style="width: 48px; height: 48px; object-fit: cover;" />
                        <span class="fs-2 fw-bold text-white tracking-tight">TalentTrack</span>
                    </div>
                    <h2 class="fw-bold display-6 mb-3">Smart Recruitment &amp; Candidate Pipeline</h2>
                    <p class="opacity-90 leading-relaxed">
                        Streamline hiring workflows, manage candidate profiles, and schedule interviews effortlessly.
                    </p>
                </div>

                <!-- Role Cards on Banner -->
                <div class="mt-3 d-none d-lg-block">
                    <div class="mb-2" style="background:rgba(255,255,255,0.1);border-radius:12px;padding:0.75rem 1rem;">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold small"><i class="bi bi-shield-lock me-1"></i>Admin Master</span>
                            <span class="badge bg-danger">Admin</span>
                        </div>
                        <div class="opacity-75" style="font-size:0.75rem;">admin@talenttrack.com / admin123</div>
                    </div>
                    <div class="mb-2" style="background:rgba(255,255,255,0.1);border-radius:12px;padding:0.75rem 1rem;">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold small"><i class="bi bi-person-workspace me-1"></i>Recruiter</span>
                            <span class="tt-role-badge-recruiter" style="font-size:0.65rem;">Approved</span>
                        </div>
                        <div class="opacity-75" style="font-size:0.75rem;">recruiter@talenttrack.com / recruiter123</div>
                    </div>
                    <div class="mb-2" style="background:rgba(255,255,255,0.1);border-radius:12px;padding:0.75rem 1rem;">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold small"><i class="bi bi-person-check me-1"></i>Interviewer</span>
                            <span class="tt-role-badge-interviewer" style="font-size:0.65rem;">Approved</span>
                        </div>
                        <div class="opacity-75" style="font-size:0.75rem;">interviewer@talenttrack.com / interviewer123</div>
                    </div>
                    @if (ViewBag.DemoCandidateEmail != null)
                    {
                        <div style="background:rgba(255,255,255,0.1);border-radius:12px;padding:0.75rem 1rem;">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold small"><i class="bi bi-person me-1"></i>Candidate</span>
                                <span class="badge bg-warning" style="font-size:0.65rem;">Portal Active</span>
                            </div>
                            <div class="opacity-75" style="font-size:0.75rem;">@ViewBag.DemoCandidateEmail / @ViewBag.DemoCandidatePassword</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Form Side -->
            <div class="col-lg-6 tt-login-form-wrapper">
                <div class="mb-4">
                    <h3 class="fw-bold text-white mb-1">Welcome Back</h3>
                    <p class="text-secondary small">Sign in to your approved account or Sign Up if you are a new user.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" id="loginForm">
                    <div class="mb-3">
                        <label class="form-label text-light fw-medium small">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-secondary border-opacity-50 text-secondary">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input type="email" name="email" id="loginEmail" class="form-control" placeholder="name@talenttrack.com" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label text-light fw-medium small">Password</label>
                            <a asp-controller="Account" asp-action="ForgotPassword" class="text-primary small text-decoration-none">Forgot Password?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-secondary border-opacity-50 text-secondary">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input type="password" name="password" id="loginPassword" class="form-control" placeholder="••••••••" required />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input bg-transparent border-secondary" type="checkbox" name="rememberMe" id="rememberMe" checked>
                            <label class="form-check-label text-secondary small" for="rememberMe">
                                Remember me
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 mb-3 fw-bold">
                        Sign In to Dashboard <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <!-- Quick Demo Fill Section -->
                    <div class="mt-3 pt-3 border-top border-secondary border-opacity-25 text-center">
                        <small class="text-secondary d-block mb-2">Quick demo login buttons:</small>
                        <div class="d-flex gap-1 justify-content-center flex-wrap">
                            <button type="button" class="btn tt-demo-btn" onclick="fillDemo('admin@talenttrack.com', 'admin123')">
                                <i class="bi bi-shield-lock me-1 text-danger"></i> Admin
                            </button>
                            <button type="button" class="btn tt-demo-btn" onclick="fillDemo('recruiter@talenttrack.com', 'recruiter123')">
                                <i class="bi bi-person-workspace me-1" style="color:#818CF8;"></i> Recruiter
                            </button>
                            <button type="button" class="btn tt-demo-btn" onclick="fillDemo('interviewer@talenttrack.com', 'interviewer123')">
                                <i class="bi bi-person-check me-1" style="color:#10B981;"></i> Interviewer
                            </button>
                            @if (ViewBag.DemoCandidates != null && ((List<TalentTrack.Models.Candidate>)ViewBag.DemoCandidates).Any())
                            {
                                <div class="dropdown d-inline-block">
                                    <button class="btn tt-demo-btn dropdown-toggle" type="button" id="candidateDemoDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person me-1" style="color:#F59E0B;"></i> Candidate
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow border-secondary" aria-labelledby="candidateDemoDropdown" style="max-height: 200px; overflow-y: auto; text-align: left;">
                                        @foreach (var c in (List<TalentTrack.Models.Candidate>)ViewBag.DemoCandidates)
                                        {
                                            <li>
                                                <a class="dropdown-item small" href="#" onclick="fillDemo('@c.Email', '@c.Phone'); return false;">
                                                    @c.Name (@c.Email)
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </form>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center">
                    <span class="text-secondary small">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-sm ms-2 px-3 fw-bold">
                        <i class="bi bi-person-plus me-1"></i> Sign Up for Access
                    </a>
                </div>

                <div class="mt-3 text-center">
                    <a asp-controller="Home" asp-action="Landing" class="text-secondary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i> Back to Landing Page
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function fillDemo(email, pass) {
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = pass;
    }
</script>