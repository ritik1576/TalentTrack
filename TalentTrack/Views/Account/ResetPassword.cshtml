@{
    ViewData["Title"] = "Reset Password";
    ViewData["HideLayoutNav"] = true;
    string email = ViewBag.Email as string ?? "";
}

<div class="tt-login-container">
    <div class="tt-login-card" style="max-width: 800px;">
        <div class="row g-0">

            <!-- Left Banner Side -->
            <div class="col-md-5 tt-login-banner text-white">
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo.png" alt="TalentTrack Logo" class="rounded-circle bg-white p-1" style="width: 48px; height: 48px; object-fit: cover;" />
                        <span class="fs-2 fw-bold text-white tracking-tight">TalentTrack</span>
                    </div>
                    <h3 class="fw-bold mb-3">Set New Password</h3>
                    <p class="opacity-90 leading-relaxed small">
                        Choose a strong password containing letters, numbers, and symbols to protect your account.
                    </p>
                </div>
            </div>

            <!-- Right Form Side -->
            <div class="col-md-7 tt-login-form-wrapper">
                <div class="mb-4">
                    <h3 class="fw-bold text-white mb-1">Reset Password</h3>
                    <p class="text-secondary small">Set your new password below for: <strong>@email</strong></p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    <input type="hidden" name="email" value="@email" />

                    <div class="mb-3">
                        <label class="form-label text-light fw-medium small">6-Digit OTP</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-shield-lock-fill"></i>
                            </span>
                            <input type="text" name="otp" class="form-control bg-dark border-secondary text-light tt-input-focus" placeholder="Enter OTP sent to your email" required maxlength="6" pattern="\d{6}" title="Please enter the 6-digit OTP" />
                        </div>
                        <div class="form-text text-secondary small">We've sent a 6-digit OTP to your email address. It is valid for 10 minutes.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light fw-medium small">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-secondary border-opacity-50 text-secondary">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required minlength="4" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light fw-medium small">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-secondary border-opacity-50 text-secondary">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required minlength="4" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 mb-3 fw-bold">
                        Update Password &amp; Login <i class="bi bi-shield-check ms-1"></i>
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
