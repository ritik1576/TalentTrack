@model IEnumerable<TalentTrack.Models.Interview>

@{
    ViewData["Title"] = "Interview Management";
    var totalInterviews = Model?.Count() ?? 0;
    var todayInterviews = Model?.Count(i => i.InterviewDate.Date == DateTime.Today) ?? 0;
    var completedInterviews = Model?.Count(i => i.Status == "Completed") ?? 0;
    var pendingInterviews = Model?.Count(i => i.Status == "Pending" || i.Status == "Scheduled") ?? 0;
}

<div class="container-fluid">
    <div class="mb-3">
        <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
            <i class="bi bi-arrow-left fs-5"></i>
            <span>Back</span>
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Interview Management</h2>
            <p class="text-muted mb-0">Manage interview schedules and track candidate progress.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-1"></i> Schedule Interview
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Total Interviews</small>
                    <h2 class="fw-bold mt-2 mb-0">@totalInterviews</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Today's Interviews</small>
                    <h2 class="fw-bold mt-2 mb-0 text-primary">@todayInterviews</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Completed</small>
                    <h2 class="fw-bold mt-2 mb-0 text-success">@completedInterviews</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Pending / Scheduled</small>
                    <h2 class="fw-bold mt-2 mb-0 text-warning">@pendingInterviews</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4 rounded-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <input type="text" name="searchCandidate" value="@Context.Request.Query["searchCandidate"]" class="form-control form-control-sm" placeholder="Search Candidate..." />
                </div>
                <div class="col-md-2">
                    <input type="text" name="searchInterviewer" value="@Context.Request.Query["searchInterviewer"]" class="form-control form-control-sm" placeholder="Search Interviewer..." />
                </div>
                <div class="col-md-2">
                    <input type="text" name="searchRecruiter" value="@Context.Request.Query["searchRecruiter"]" class="form-control form-control-sm" placeholder="Search Recruiter..." />
                </div>
                <div class="col-md-2">
                    <input type="date" name="filterDate" value="@Context.Request.Query["filterDate"]" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <select name="filterStatus" class="form-select form-select-sm">
                        <option value="">-- All Statuses --</option>
                        <option value="Scheduled" selected="@(Context.Request.Query["filterStatus"] == "Scheduled" ? "selected" : null)">Scheduled</option>
                        <option value="Confirmed" selected="@(Context.Request.Query["filterStatus"] == "Confirmed" ? "selected" : null)">Confirmed</option>
                        <option value="Pending" selected="@(Context.Request.Query["filterStatus"] == "Pending" ? "selected" : null)">Pending</option>
                        <option value="Completed" selected="@(Context.Request.Query["filterStatus"] == "Completed" ? "selected" : null)">Completed</option>
                        <option value="Cancelled" selected="@(Context.Request.Query["filterStatus"] == "Cancelled" ? "selected" : null)">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-search"></i></button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-2 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Candidate</th>
                            <th>Panel Members</th>
                            <th>Date / Time</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var interview in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 36px; height: 36px;">
                                                @(string.IsNullOrEmpty(interview.Candidate?.Name) ? "?" : interview.Candidate.Name.Substring(0, 1).ToUpper())
                                            </div>
                                            <span>@(interview.Candidate?.Name ?? "N/A")</span>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var techInterviews = interview.Interviewers.ToList();
                                            var recruiters = interview.recruiters().ToList();
                                        }
                                        @if (techInterviews.Any())
                                        {
                                            <div class="small"><strong class="text-success">Interviewers:</strong> @string.Join(", ", techInterviews.Select(u => u.Name))</div>
                                        }
                                        @if (recruiters.Any())
                                        {
                                            <div class="small"><strong class="text-primary">Recruiters:</strong> @string.Join(", ", recruiters.Select(u => u.Name))</div>
                                        }
                                        @if (!techInterviews.Any() && !recruiters.Any())
                                        {
                                            <span class="text-warning small"><i class="bi bi-person-x me-1"></i>Unassigned</span>
                                        }
                                    </td>
                                    <td>
                                        <div><i class="bi bi-calendar3 me-1 text-muted"></i>@interview.InterviewDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@interview.InterviewDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>@interview.Duration mins</td>
                                    <td>
                                        @if (interview.Status == "Confirmed" || interview.Status == "Completed")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@interview.Status</span>
                                        }
                                        else if (interview.Status == "Pending" || interview.Status == "Scheduled")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">@interview.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">@interview.Status</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-3">
                                            <a asp-action="Edit" asp-route-id="@interview.InterviewId" class="text-primary text-decoration-none" title="Edit">
                                                <i class="bi bi-pencil fs-5"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@interview.InterviewId" onclick="return confirm('Are you sure you want to delete this interview schedule?');" class="text-danger text-decoration-none" title="Delete">
                                                <i class="bi bi-trash fs-5"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-event display-6 d-block mb-2 text-secondary opacity-50"></i>
                                    <span>No interviews scheduled yet. Click <strong>Schedule Interview</strong> to add one.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>