@model IEnumerable<TalentTrack.Models.Interview>

@{
    ViewData["Title"] = "Interview Management";
    var totalInterviews = Model?.Count() ?? 0;
    var todayInterviews = Model?.Count(i => i.InterviewDate.Date == DateTime.Today) ?? 0;
    var completedInterviews = Model?.Count(i => i.Status == "Completed") ?? 0;
    var pendingInterviews = Model?.Count(i => i.Status == "Pending" || i.Status == "Scheduled") ?? 0;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Interview Management</h2>
            <p class="text-muted mb-0">Manage interview schedules and track candidate progress.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-1"></i> Schedule Interview
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Total Interviews</small>
                    <h2 class="fw-bold mt-2 mb-0">@totalInterviews</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Today's Interviews</small>
                    <h2 class="fw-bold mt-2 mb-0 text-primary">@todayInterviews</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Completed</small>
                    <h2 class="fw-bold mt-2 mb-0 text-success">@completedInterviews</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <small class="text-muted">Pending / Scheduled</small>
                    <h2 class="fw-bold mt-2 mb-0 text-warning">@pendingInterviews</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Candidate</th>
                            <th>Position</th>
                            <th>Interviewer</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var interview in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 36px; height: 36px;">
                                                @(string.IsNullOrEmpty(interview.Candidate?.Name) ? "?" : interview.Candidate.Name.Substring(0, 1).ToUpper())
                                            </div>
                                            <span>@(interview.Candidate?.Name ?? "N/A")</span>
                                        </div>
                                    </td>
                                    <td>@(interview.Job?.JobTitle ?? "N/A")</td>
                                    <td>
                                        @if (interview.Interviewer != null)
                                        {
                                            <span><i class="bi bi-person-check-fill me-1 text-success"></i>@interview.Interviewer.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning small"><i class="bi bi-person-x me-1"></i>Unassigned</span>
                                        }
                                    </td>
                                    <td><i class="bi bi-calendar3 me-1 text-muted"></i>@interview.InterviewDate.ToString("dd MMM yyyy")</td>
                                    <td><i class="bi bi-clock me-1 text-muted"></i>@interview.InterviewDate.ToString("hh:mm tt")</td>
                                    <td>
                                        @if (interview.Status == "Confirmed" || interview.Status == "Completed")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@interview.Status</span>
                                        }
                                        else if (interview.Status == "Pending" || interview.Status == "Scheduled")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">@interview.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">@interview.Status</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a asp-action="Edit" asp-route-id="@interview.InterviewId" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@interview.InterviewId" onclick="return confirm('Are you sure you want to delete this interview schedule?');" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-event display-6 d-block mb-2 text-secondary opacity-50"></i>
                                    <span>No interviews scheduled yet. Click <strong>Schedule Interview</strong> to add one.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>