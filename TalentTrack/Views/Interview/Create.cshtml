@model TalentTrack.Models.Interview

@{
    ViewData["Title"] = "Schedule Interview";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
        <i class="bi bi-arrow-left fs-5"></i>
        <span>Back</span>
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header border-0 py-3 px-4" style="background:var(--tt-gradient-primary);">
                <h5 class="mb-0 fw-bold text-white">
                    <i class="bi bi-calendar-plus me-2"></i>Schedule New Interview
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">

                    <div class="row g-3">
                        <!-- Candidate -->
                        <div class="col-md-6">
                            <label asp-for="CandidateId" class="form-label fw-medium">
                                <i class="bi bi-person me-1 text-primary"></i>Candidate
                            </label>
                            <select asp-for="CandidateId" class="form-select" asp-items="ViewBag.Candidates" required>
                                <option value="">-- Select Candidate --</option>
                            </select>
                            <span asp-validation-for="CandidateId" class="text-danger small"></span>
                        </div>

                        <!-- Recruiter -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-medium mb-2">
                                <i class="bi bi-people me-1 text-primary"></i>Assign Recruiter
                            </label>
                            <select name="SelectedRecruiterId" class="form-select" asp-items="ViewBag.Recruiters" required>
                                <option value="">-- Select Recruiter --</option>
                            </select>
                        </div>

                        <!-- Technical Interviewers -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-medium mb-2">
                                <i class="bi bi-person-check me-1 text-success"></i>Assign Technical Interviewers (Min 1)
                            </label>
                            <div class="border rounded p-3 bg-light" style="max-height: 120px; overflow-y: auto;">
                                @if (ViewBag.Interviewers != null)
                                {
                                    int index = 0;
                                    foreach (var item in (MultiSelectList)ViewBag.Interviewers)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="SelectedInterviewers" value="@item.Value" id="interviewer_@index" @(item.Selected ? "checked" : "") />
                                            <label class="form-check-label fw-semibold text-dark mb-0" for="interviewer_@index">
                                                @item.Text
                                            </label>
                                        </div>
                                        index++;
                                    }
                                }
                            </div>
                        </div>

                        <!-- Duration -->
                        <div class="col-md-6">
                            <label asp-for="Duration" class="form-label fw-medium">
                                <i class="bi bi-hourglass-split me-1 text-info"></i>Duration (Minutes)
                            </label>
                            <input asp-for="Duration" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="Duration" class="text-danger small"></span>
                        </div>

                        <input type="hidden" asp-for="Mode" value="Offline" />

                        <!-- Date & Time -->
                        <div class="col-md-6">
                            <label asp-for="InterviewDate" class="form-label fw-medium">
                                <i class="bi bi-clock me-1 text-warning"></i>Date &amp; Time (Future Only)
                            </label>
                            <input asp-for="InterviewDate" type="datetime-local" class="form-control"
                                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                            <span asp-validation-for="InterviewDate" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-medium">
                                <i class="bi bi-flag me-1 text-secondary"></i>Status
                            </label>
                            <select asp-for="Status" class="form-select">
                                <option value="Scheduled">Scheduled</option>
                                <option value="Confirmed">Confirmed</option>
                                <option value="Pending">Pending</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <!-- Notes -->
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-medium">
                                <i class="bi bi-sticky me-1 text-secondary"></i>Notes / Instructions
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="2"
                                      placeholder="e.g. Focus on system design, bring portfolio..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-calendar-check me-1"></i>Schedule Interview
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
