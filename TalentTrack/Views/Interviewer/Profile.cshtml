@model TalentTrack.Models.Interviewer

@{
    ViewData["Title"] = "Interviewer Profile";
}

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Profile Hero -->
    <div class="tt-profile-hero" style="background:linear-gradient(135deg,#10B981 0%,#06B6D4 100%);">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="tt-profile-avatar">@(Model.AvatarInitials ?? Model.Name.Substring(0,1).ToUpper())</div>
            </div>
            <div class="col">
                <h3 class="fw-bold mb-1">@Model.Name</h3>
                <div class="opacity-80 mb-1">@Model.Email</div>
                @if (!string.IsNullOrEmpty(Model.Department))
                {
                    <div class="opacity-75 small mb-2"><i class="bi bi-building me-1"></i>@Model.Department · @Model.Specialization</div>
                }
                <span class="tt-role-badge-interviewer"><i class="bi bi-person-check me-1"></i>Interviewer</span>
            </div>
            <div class="col-auto d-none d-md-block text-end text-white">
                <div class="fw-bold fs-4">@(Model.YearsExperience ?? 0)+</div>
                <small class="opacity-75">Years Experience</small>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <div class="mt-3 pt-3 border-top border-white border-opacity-20 opacity-85 small">
                <i class="bi bi-quote me-1"></i>@Model.Bio
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Edit Form -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-success"></i>Edit Profile</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Interviewer" asp-action="Profile" method="post">
                        <input type="hidden" asp-for="InterviewerId" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Email (Read-only)</label>
                                <input asp-for="Email" class="form-control" readonly style="background:#f8fafc;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Phone Number</label>
                                <input asp-for="Phone" class="form-control" placeholder="e.g. 9876543210" type="tel" maxlength="10" pattern="[0-9]{10}" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Department</label>
                                <input asp-for="Department" class="form-control" placeholder="e.g. Engineering, HR" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Specialization</label>
                                <input asp-for="Specialization" class="form-control" placeholder="e.g. Full Stack, Data Science" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Years of Experience</label>
                                <input asp-for="YearsExperience" type="number" class="form-control" min="0" max="50" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium">LinkedIn Profile URL</label>
                                <input asp-for="LinkedIn" class="form-control" placeholder="linkedin.com/in/yourname" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-medium">Bio / About Me</label>
                                <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Brief professional description..."></textarea>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                            <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Stats Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-person-lines-fill me-2 text-success"></i>Profile Details</h6>
                    <div class="d-flex flex-column gap-3">
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="tt-icon-bubble tt-icon-success" style="width:36px;height:36px;font-size:0.9rem;"><i class="bi bi-telephone"></i></div>
                                <div>
                                    <div class="fw-medium small">Phone</div>
                                    <div class="text-muted small">@Model.Phone</div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Department))
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="tt-icon-bubble tt-icon-primary" style="width:36px;height:36px;font-size:0.9rem;"><i class="bi bi-building"></i></div>
                                <div>
                                    <div class="fw-medium small">Department</div>
                                    <div class="text-muted small">@Model.Department</div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.LinkedIn))
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="tt-icon-bubble tt-icon-primary" style="width:36px;height:36px;font-size:0.9rem;"><i class="bi bi-linkedin"></i></div>
                                <div>
                                    <div class="fw-medium small">LinkedIn</div>
                                    <div class="text-muted small">@Model.LinkedIn</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-link-45deg me-2 text-success"></i>Quick Links</h6>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Interviewer" asp-action="Dashboard" class="btn btn-outline-success btn-sm text-start">
                            <i class="bi bi-grid me-2"></i>My Dashboard
                        </a>
                        <a asp-controller="Feedback" asp-action="Index" class="btn btn-outline-primary btn-sm text-start">
                            <i class="bi bi-star me-2"></i>My Feedbacks
                        </a>
                        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="bi bi-gear me-2"></i>Settings
                        </a>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm text-start">
                            <i class="bi bi-box-arrow-right me-2"></i>Log Out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
