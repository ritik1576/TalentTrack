@{
    ViewData["Title"] = "Admin Control Panel";
    var pendingUsers = ViewBag.PendingUsers as List<TalentTrack.Models.Recruiter> ?? new List<TalentTrack.Models.Recruiter>();
    var approvedUsers = ViewBag.ApprovedUsers as List<TalentTrack.Models.Recruiter> ?? new List<TalentTrack.Models.Recruiter>();
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Admin Control Panel</h2>
            <p class="text-muted mb-0">Approve user signups, manage roles, and monitor system activities.</p>
        </div>
        <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-person-gear me-1"></i>System Admin Mode</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="tt-icon-bubble tt-icon-warning mx-auto mb-2"><i class="bi bi-clock-history"></i></div>
                <h3 class="fw-bold text-warning mb-0">@pendingUsers.Count</h3>
                <small class="text-muted">Pending Approvals</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="tt-icon-bubble tt-icon-success mx-auto mb-2"><i class="bi bi-person-check-fill"></i></div>
                <h3 class="fw-bold text-success mb-0">@approvedUsers.Count</h3>
                <small class="text-muted">Active Approved Users</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="tt-icon-bubble tt-icon-primary mx-auto mb-2"><i class="bi bi-people-fill"></i></div>
                <h3 class="fw-bold text-primary mb-0">@ViewBag.TotalCandidates</h3>
                <small class="text-muted">Total Candidates</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="tt-icon-bubble tt-icon-danger mx-auto mb-2"><i class="bi bi-calendar-check-fill"></i></div>
                <h3 class="fw-bold text-danger mb-0">@ViewBag.TotalInterviews</h3>
                <small class="text-muted">Interviews Scheduled</small>
            </div>
        </div>
    </div>

    <!-- PENDING APPROVALS TABLE -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left:4px solid #F59E0B!important;">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-person-exclamation me-2 text-warning"></i>Pending Signup Approval Requests</h5>
            <span class="badge bg-warning text-dark px-3 py-2">@pendingUsers.Count Requests Pending</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Email</th>
                            <th>Requested Role</th>
                            <th>Department</th>
                            <th>Registered Date</th>
                            <th>Status</th>
                            <th class="pe-4 text-end">Admin Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pendingUsers.Any())
                        {
                            @foreach (var user in pendingUsers)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-warning bg-opacity-20 text-dark d-flex align-items-center justify-content-center fw-bold" style="width:34px;height:34px;font-size:12px;">
                                                @user.Name.Substring(0, 1).ToUpper()
                                            </div>
                                            @user.Name
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.Role == "Recruiter")
                                        {
                                            <span class="tt-role-badge-recruiter">Recruiter</span>
                                        }
                                        else
                                        {
                                            <span class="tt-role-badge-interviewer">Interviewer</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(user.Department) ? "—" : user.Department)</td>
                                    <td><small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@user.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small></td>
                                    <td><span class="badge bg-warning text-dark border border-warning">Pending Approval</span></td>
                                    <td class="pe-4 text-end">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <form asp-controller="Admin" asp-action="Approve" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@user.RecruiterId" />
                                                <button type="submit" class="btn btn-sm btn-success px-3 fw-bold">
                                                    <i class="bi bi-check-lg me-1"></i> Approve
                                                </button>
                                            </form>
                                            <form asp-controller="Admin" asp-action="Reject" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@user.RecruiterId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-3" onclick="return confirm('Are you sure you want to REJECT this account?');">
                                                    <i class="bi bi-x-lg me-1"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-check-all text-success me-1 fs-5"></i> No pending approval requests at this time. All users are reviewed!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- APPROVED USERS DIRECTORY -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 px-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2 text-success"></i>Approved System Accounts</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Phone</th>
                            <th>Approved Date</th>
                            <th class="pe-4 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in approvedUsers)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@user.Name</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (user.Role == "Recruiter")
                                    {
                                        <span class="tt-role-badge-recruiter">Recruiter</span>
                                    }
                                    else
                                    {
                                        <span class="tt-role-badge-interviewer">Interviewer</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(user.Phone) ? "—" : user.Phone)</td>
                                <td><small class="text-muted">@user.CreatedAt.ToString("dd MMM yyyy")</small></td>
                                <td class="pe-4 text-end">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1">Active</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
