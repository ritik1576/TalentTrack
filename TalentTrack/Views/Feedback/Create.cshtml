@model TalentTrack.Models.InterviewFeedback

@{
    ViewData["Title"] = "Submit Interview Feedback";
    var interview = ViewBag.Interview as TalentTrack.Models.Interview;
}

<div class="container-fluid">
    <div class="mb-3">
        <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
            <i class="bi bi-arrow-left fs-5"></i>
            <span>Back</span>
        </a>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <!-- Header -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="tt-icon-bubble tt-icon-warning" style="width:52px;height:52px;font-size:1.4rem;">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Interview Feedback</h4>
                    <p class="text-muted mb-0 small">
                        Candidate: <strong>@(interview?.Candidate?.Name ?? "N/A")</strong>
                        &nbsp;|&nbsp; Position: <strong>@(interview?.Job?.JobTitle ?? "N/A")</strong>
                        &nbsp;|&nbsp; Date: <strong>@(interview?.InterviewDate.ToString("dd MMM yyyy, hh:mm tt") ?? "")</strong>
                    </p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="InterviewId" />
                <input type="hidden" asp-for="CandidateId" />
                <input type="hidden" name="Recommendation" id="recommendationValue" value="Recommended" />

                <!-- Overall Rating -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-star-fill text-warning me-2"></i>Overall Rating</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small mb-3">How would you rate this candidate overall? (1 = Poor, 5 = Excellent)</p>
                        <div class="tt-star-rating" id="starRating">
                            <input type="radio" name="OverallRating" id="star5" value="5" />
                            <label for="star5" title="Excellent"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="OverallRating" id="star4" value="4" />
                            <label for="star4" title="Good"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="OverallRating" id="star3" value="3" checked />
                            <label for="star3" title="Average"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="OverallRating" id="star2" value="2" />
                            <label for="star2" title="Below Average"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" name="OverallRating" id="star1" value="1" />
                            <label for="star1" title="Poor"><i class="bi bi-star-fill"></i></label>
                        </div>
                        <div id="ratingLabel" class="text-muted small mt-2">Rating: <strong>3</strong> / 5 — Average</div>
                    </div>
                </div>

                <!-- Skill Scores -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Technical Skill Ratings</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="showAddSkillModal()">
                            <i class="bi bi-plus-lg me-1"></i> Add Manual Skill
                        </button>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small mb-4">Rate each required skill on a scale of 1 to 5 and provide brief comments.</p>

                        <div id="dynamicSkillsContainer" class="d-flex flex-column gap-4">
                            <!-- Dynamically Rendered Skills -->
                        </div>
                    </div>
                </div>

                <!-- Qualitative Feedback -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-chat-left-text-fill text-info me-2"></i>Detailed Feedback / Comments</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-medium"><i class="bi bi-chat-left-quote-fill me-1 text-primary"></i>Overall Comments</label>
                                <textarea name="Comments" id="overallCommentsInput" class="form-control" rows="4" required
                                          placeholder="Write your comprehensive assessment of the candidate's performance, qualifications, and fit for the role..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recommendation -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-check2-circle me-2 text-success"></i>Final Recommendation</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small mb-3">What is your hiring recommendation for this candidate?</p>
                        <div class="d-flex gap-3 flex-wrap">
                            <button type="button" class="tt-recommend-btn hire active" onclick="setRecommendation('Recommended', this)">
                                <i class="bi bi-check-circle-fill me-2"></i>Recommended
                            </button>
                            <button type="button" class="tt-recommend-btn reject" onclick="setRecommendation('Not Recommended', this)">
                                <i class="bi bi-x-circle-fill me-2"></i>Not Recommended
                            </button>
                        </div>
                        <div id="recLabel" class="mt-3 text-muted small">Selected: <strong>Recommended</strong></div>
                    </div>
                </div>

                <!-- Submit -->
                <div class="d-flex gap-3 justify-content-end">
                    <a asp-controller="Interviewer" asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="button" onclick="submitFeedbackForm()" class="btn btn-primary px-5">
                        <i class="bi bi-send-fill me-2"></i>Submit Feedback
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Skill Modal -->
<div class="modal fade" id="addSkillModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Custom Skill</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <div class="mb-3">
                    <label for="customSkillName" class="form-label fw-medium">Skill Name</label>
                    <input type="text" class="form-control" id="customSkillName" placeholder="e.g. AWS, Git, CI/CD" />
                    <div id="modalError" class="text-danger small mt-1 d-none"></div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="addManualSkill()">Add Skill</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Star Rating Labels
    const ratingLabels = ['', 'Poor', 'Below Average', 'Average', 'Good', 'Excellent'];
    document.querySelectorAll('#starRating input').forEach(input => {
        input.addEventListener('change', function () {
            const v = parseInt(this.value);
            document.getElementById('ratingLabel').innerHTML =
                `Rating: <strong>${v}</strong> / 5 — ${ratingLabels[v]}`;
        });
    });

    // Dynamic skills array
    let skillsList = [
        @if (interview?.Job?.JobSkills != null)
        {
            foreach (var js in interview.Job.JobSkills)
            {
                <text>{ jobSkillId: @js.JobSkillId, name: "@js.SkillName", source: "@js.Source", rating: 3, comment: "" },</text>
            }
        }
    ];

    function renderDynamicSkills() {
        const container = document.getElementById('dynamicSkillsContainer');
        if (skillsList.length === 0) {
            container.innerHTML = `
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                    <span>No criteria skills found for this job. Add custom skills if needed.</span>
                </div>
            `;
            return;
        }

        container.innerHTML = skillsList.map((skill, index) => `
            <div class="border rounded-4 p-3 bg-light bg-opacity-30 position-relative">
                ${skill.source === 'manual' ? `
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" style="font-size: 0.8rem;" onclick="removeSkill(${index})"></button>
                ` : ''}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-dark d-flex align-items-center gap-2">
                        ${skill.name}
                        <span class="badge ${skill.source === 'jd_extracted' ? 'bg-primary' : 'bg-secondary'} bg-opacity-10 text-${skill.source === 'jd_extracted' ? 'primary' : 'secondary'} border border-${skill.source === 'jd_extracted' ? 'primary' : 'secondary'} border-opacity-25 py-1" style="font-size: 0.7rem;">
                            ${skill.source === 'jd_extracted' ? 'JD Extracted' : 'Manual'}
                        </span>
                    </span>
                    <span class="badge bg-primary fs-6">Rating: <strong id="skillVal_${index}">${skill.rating}</strong> / 5</span>
                </div>
                <div class="mb-3">
                    <input type="range" class="tt-score-slider w-100" min="1" max="5" value="${skill.rating}" oninput="updateSkillSlider(this, ${index})" />
                    <div class="d-flex justify-content-between text-muted small mt-1"><span>1 (Weak)</span><span>5 (Expert)</span></div>
                </div>
                <div>
                    <label class="form-label small text-muted">Detailed Skill Comments</label>
                    <textarea class="form-control form-control-sm" rows="2" placeholder="Specific notes about candidate's skill in ${skill.name}..." oninput="updateSkillComment(this, ${index})">${skill.comment}</textarea>
                </div>
            </div>
        `).join('');
        
        // Init sliders property update
        document.querySelectorAll('#dynamicSkillsContainer input[type="range"]').forEach(el => {
            const pct = ((el.value - el.min) / (el.max - el.min)) * 100;
            el.style.setProperty('--val', pct + '%');
        });
    }

    function updateSkillSlider(el, index) {
        skillsList[index].rating = parseInt(el.value);
        document.getElementById(`skillVal_${index}`).textContent = el.value;
        const pct = ((el.value - el.min) / (el.max - el.min)) * 100;
        el.style.setProperty('--val', pct + '%');
    }

    function updateSkillComment(el, index) {
        skillsList[index].comment = el.value;
    }

    function removeSkill(index) {
        skillsList.splice(index, 1);
        renderDynamicSkills();
    }

    function showAddSkillModal() {
        document.getElementById('customSkillName').value = '';
        document.getElementById('modalError').classList.add('d-none');
        const modal = new bootstrap.Modal(document.getElementById('addSkillModal'));
        modal.show();
    }

    function addManualSkill() {
        const nameInput = document.getElementById('customSkillName');
        const name = nameInput.value.trim();
        const errorEl = document.getElementById('modalError');

        if (!name) {
            errorEl.textContent = 'Skill name is required.';
            errorEl.classList.remove('d-none');
            return;
        }

        const isDuplicate = skillsList.some(s => s.name.toLowerCase() === name.toLowerCase());
        if (isDuplicate) {
            errorEl.textContent = 'This skill is already in the list.';
            errorEl.classList.remove('d-none');
            return;
        }

        skillsList.push({
            jobSkillId: null,
            name: name,
            source: 'manual',
            rating: 3,
            comment: ''
        });

        renderDynamicSkills();
        bootstrap.Modal.getInstance(document.getElementById('addSkillModal')).hide();
    }

    // Recommendation
    function setRecommendation(val, btn) {
        document.getElementById('recommendationValue').value = val;
        document.getElementById('recLabel').innerHTML = `Selected: <strong>${val}</strong>`;
        document.querySelectorAll('.tt-recommend-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    async function submitFeedbackForm() {
        const overallComments = document.getElementById('overallCommentsInput').value.trim();
        if (!overallComments) {
            alert('Overall comments are required.');
            return;
        }

        // Validate individual ratings
        for (const s of skillsList) {
            if (s.rating < 1 || s.rating > 5) {
                alert(`Rating for skill '${s.name}' must be between 1 and 5.`);
                return;
            }
        }

        const payload = {
            candidateId: parseInt('@Model.CandidateId'),
            jobId: parseInt('@(interview?.JobId ?? 0)'),
            overallComments: overallComments,
            finalRecommendation: document.getElementById('recommendationValue').value,
            skills: skillsList.map(s => ({
                jobSkillId: s.jobSkillId,
                skill: s.name,
                rating: s.rating,
                comment: s.comment
            }))
        };

        try {
            const response = await fetch('/feedback', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                window.location.href = '/Interviewer/Dashboard';
            } else {
                const errData = await response.json();
                alert('Error: ' + (errData.message || 'Failed to submit feedback.'));
            }
        } catch (err) {
            console.error(err);
            alert('A network error occurred. Please try again.');
        }
    }

    // Initial render on page load
    document.addEventListener('DOMContentLoaded', () => {
        renderDynamicSkills();
    });
</script>
}
