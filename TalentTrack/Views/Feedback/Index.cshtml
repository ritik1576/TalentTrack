@model List<TalentTrack.Models.InterviewFeedback>

@{
    ViewData["Title"] = "Interview Feedback & Ratings";
    string userRole = Context.Session.GetString("UserRole") ?? "";
}

<div class="container-fluid">
    <div class="mb-3">
        <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
            <i class="bi bi-arrow-left fs-5"></i>
            <span>Back</span>
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-star-fill text-warning me-2"></i>Interview Feedback</h2>
            <p class="text-muted mb-0">
                @if (userRole == "Recruiter")
                {
                    <span>Review all candidate evaluations submitted by interviewers.</span>
                }
                else
                {
                    <span>Feedbacks submitted by you for candidates.</span>
                }
            </p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2">
                @Model.Count Total Feedbacks
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body py-5 text-center">
                <i class="bi bi-star text-muted" style="font-size:3rem;"></i>
                <p class="text-muted mt-3">No feedback submitted yet.</p>
                @if (userRole == "Interviewer")
                {
                    <a asp-controller="Interviewer" asp-action="Dashboard" class="btn btn-primary">
                        Go to Dashboard
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var candidateGroup in Model.GroupBy(f => f.CandidateId))
            {
                var firstFb = candidateGroup.First();
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <!-- Candidate Header -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="tt-avatar" style="width:48px;height:48px;font-size:1.1rem;background-color:#E8F0FE;color:#1A73E8;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;">
                                    @(firstFb.Candidate?.Name?.Substring(0,1).ToUpper() ?? "?")
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold fs-5">@(firstFb.Candidate?.Name ?? "N/A")</div>
                                    <div class="text-muted small">@(firstFb.Interview?.Job?.JobTitle ?? "N/A")</div>
                                </div>
                            </div>

                            <hr class="my-3 opacity-10" />

                            <!-- Feedbacks List -->
                            <div class="d-flex flex-column gap-3">
                                @foreach (var fb in candidateGroup)
                                {
                                    string badgeStyle = (fb.Recommendation == "Hire" || fb.Recommendation == "Recommended" || fb.Recommendation == "Recommend") 
                                        ? "background-color: #E6F4EA !important; color: #137333 !important; border: 1px solid #CEEAD6 !important;" 
                                        : (fb.Recommendation == "Reject" || fb.Recommendation == "Not Recommended" || fb.Recommendation == "Not Recommend") 
                                            ? "background-color: #FCE8E6 !important; color: #C5221F !important; border: 1px solid #FAD2CF !important;" 
                                            : "background-color: #FEF7E0 !important; color: #B06000 !important; border: 1px solid #FEEFC3 !important;";
                                    string recIcon = (fb.Recommendation == "Hire" || fb.Recommendation == "Recommended" || fb.Recommendation == "Recommend") ? "bi-check-circle-fill" :
                                                     (fb.Recommendation == "Reject" || fb.Recommendation == "Not Recommended" || fb.Recommendation == "Not Recommend") ? "bi-x-circle-fill" : "bi-pause-circle-fill";

                                    <div class="p-3 border rounded-3 bg-white shadow-xs">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <span class="fw-semibold text-dark text-sm"><i class="bi bi-person me-1"></i>@(fb.Interviewer?.Name ?? "N/A")</span>
                                                <div class="text-muted extra-small" style="font-size:0.75rem;"><i class="bi bi-calendar3 me-1"></i>@fb.CreatedAt.ToString("dd MMM yyyy")</div>
                                            </div>
                                            <span class="badge px-2 py-1" style="@badgeStyle; font-size:0.75rem;">
                                                <i class="bi @recIcon me-1"></i>@fb.Recommendation
                                            </span>
                                        </div>

                                        <!-- Star Rating -->
                                        <div class="d-flex align-items-center gap-1 mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= fb.OverallRating)
                                                {
                                                    <i class="bi bi-star-fill text-warning" style="font-size:0.85rem;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-muted opacity-25" style="font-size:0.85rem;"></i>
                                                }
                                            }
                                            <span class="ms-1 text-muted small" style="font-size:0.8rem;">@fb.OverallRating/5</span>
                                        </div>

                                        <!-- Score Bars -->
                                        @if (fb.SkillRatings != null && fb.SkillRatings.Any())
                                        {
                                            <div class="mb-2">
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var sr in fb.SkillRatings)
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1" style="font-size:0.7rem;">
                                                            @sr.SkillName: <strong>@sr.Rating/5</strong>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mb-2">
                                                <div class="row g-2">
                                                    <div class="col-4">
                                                        <div class="d-flex justify-content-between mb-1" style="font-size:0.7rem;">
                                                            <span class="text-muted">Tech</span>
                                                            <span class="fw-bold">@fb.TechnicalScore/10</span>
                                                        </div>
                                                        <div class="progress" style="height:4px;border-radius:2px;">
                                                            <div class="progress-bar bg-primary" style="width:@(fb.TechnicalScore * 10)%"></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="d-flex justify-content-between mb-1" style="font-size:0.7rem;">
                                                            <span class="text-muted">Comm</span>
                                                            <span class="fw-bold">@fb.CommunicationScore/10</span>
                                                        </div>
                                                        <div class="progress" style="height:4px;border-radius:2px;">
                                                            <div class="progress-bar bg-success" style="width:@(fb.CommunicationScore * 10)%"></div>
                                                        </div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="d-flex justify-content-between mb-1" style="font-size:0.7rem;">
                                                            <span class="text-muted">Problem</span>
                                                            <span class="fw-bold">@fb.ProblemSolvingScore/10</span>
                                                        </div>
                                                        <div class="progress" style="height:4px;border-radius:2px;">
                                                            <div class="progress-bar bg-warning" style="width:@(fb.ProblemSolvingScore * 10)%"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Comments Preview -->
                                        @if (!string.IsNullOrEmpty(fb.Comments))
                                        {
                                            <div class="bg-light rounded-2 p-2 mb-2">
                                                <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">
                                                    <i class="bi bi-quote me-1"></i>
                                                    @fb.Comments
                                                </small>
                                            </div>
                                        }

                                        <div class="text-end">
                                            <a asp-action="Details" asp-route-id="@fb.FeedbackId" class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size:0.75rem;">
                                                <i class="bi bi-eye me-1"></i>Details
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (userRole == "Recruiter" || userRole == "Admin")
                            {
                                var candidateApps = ViewBag.Applications as List<CandidateApplication> ?? new List<CandidateApplication>();
                                var app = candidateApps.FirstOrDefault(a => a.CandidateId == firstFb.CandidateId && a.JobId == firstFb.Interview?.JobId);
                                
                                <div class="mt-3 pt-3 border-top">
                                    @if (app != null)
                                    {
                                        @if (!string.IsNullOrEmpty(app.BackgroundVerificationStatus))
                                        {
                                            @if (app.BackgroundVerificationStatus == "Rejected")
                                            {
                                                <div class="alert alert-danger mb-0 py-2 text-center rounded-3 border-0 small" role="alert">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Candidate Rejected
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-success mb-0 py-2 text-center rounded-3 border-0 small" role="alert">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Verification Portal Active
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="d-flex gap-2">
                                                <form asp-action="ProcessApplication" method="post" class="flex-fill">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                                    <input type="hidden" name="decision" value="Accept" />
                                                    <button type="submit" class="btn btn-sm btn-success w-100 py-2 rounded-3 fw-semibold shadow-xs">
                                                        <i class="bi bi-person-check-fill me-1"></i>Accept & Enable Portal
                                                    </button>
                                                </form>
                                                <form asp-action="ProcessApplication" method="post" class="flex-fill">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                                    <input type="hidden" name="decision" value="Reject" />
                                                    <button type="submit" class="btn btn-sm btn-danger w-100 py-2 rounded-3 fw-semibold shadow-xs">
                                                        <i class="bi bi-person-x-fill me-1"></i>Reject Candidate
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
