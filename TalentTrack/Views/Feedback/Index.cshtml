@model List<TalentTrack.Models.InterviewFeedback>

@{
    ViewData["Title"] = "Interview Feedback & Ratings";
    string userRole = Context.Session.GetString("UserRole") ?? "";
}

<div class="container-fluid">
    <div class="mb-3">
        <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
            <i class="bi bi-arrow-left fs-5"></i>
            <span>Back</span>
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-star-fill text-warning me-2"></i>Interview Feedback</h2>
            <p class="text-muted mb-0">
                @if (userRole == "Recruiter")
                {
                    <span>Review all candidate evaluations submitted by interviewers.</span>
                }
                else
                {
                    <span>Feedbacks submitted by you for candidates.</span>
                }
            </p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2">
                @Model.Count Total Feedbacks
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body py-5 text-center">
                <i class="bi bi-star text-muted" style="font-size:3rem;"></i>
                <p class="text-muted mt-3">No feedback submitted yet.</p>
                @if (userRole == "Interviewer")
                {
                    <a asp-controller="Interviewer" asp-action="Dashboard" class="btn btn-primary">
                        Go to Dashboard
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var fb in Model)
            {
                string badgeStyle = (fb.Recommendation == "Hire" || fb.Recommendation == "Recommended" || fb.Recommendation == "Recommend") 
                    ? "background-color: #E6F4EA !important; color: #137333 !important; border: 1px solid #CEEAD6 !important;" 
                    : (fb.Recommendation == "Reject" || fb.Recommendation == "Not Recommended" || fb.Recommendation == "Not Recommend") 
                        ? "background-color: #FCE8E6 !important; color: #C5221F !important; border: 1px solid #FAD2CF !important;" 
                        : "background-color: #FEF7E0 !important; color: #B06000 !important; border: 1px solid #FEEFC3 !important;";
                string recIcon = (fb.Recommendation == "Hire" || fb.Recommendation == "Recommended" || fb.Recommendation == "Recommend") ? "bi-check-circle-fill" :
                                 (fb.Recommendation == "Reject" || fb.Recommendation == "Not Recommended" || fb.Recommendation == "Not Recommend") ? "bi-x-circle-fill" : "bi-pause-circle-fill";
                int avgScore = (fb.TechnicalScore + fb.CommunicationScore + fb.ProblemSolvingScore) / 3;

                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <!-- Candidate Header -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="tt-avatar" style="width:48px;height:48px;font-size:1.1rem;">
                                    @(fb.Candidate?.Name?.Substring(0,1).ToUpper() ?? "?")
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">@(fb.Candidate?.Name ?? "N/A")</div>
                                    <div class="text-muted small">@(fb.Interview?.Job?.JobTitle ?? "N/A")</div>
                                </div>
                                <span class="badge px-2 py-1" style="@badgeStyle">
                                    <i class="bi @recIcon me-1"></i>@fb.Recommendation
                                </span>
                            </div>

                            <!-- Star Rating -->
                            <div class="d-flex align-items-center gap-1 mb-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= fb.OverallRating)
                                    {
                                        <i class="bi bi-star-fill tt-star-display"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star tt-star-display empty"></i>
                                    }
                                }
                                <span class="ms-1 text-muted small">@fb.OverallRating/5</span>
                            </div>

                            <!-- Score Bars -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Technical</small>
                                    <small class="fw-bold">@fb.TechnicalScore/10</small>
                                </div>
                                <div class="progress" style="height:5px;border-radius:3px;">
                                    <div class="progress-bar bg-primary" style="width:@(fb.TechnicalScore * 10)%"></div>
                                </div>

                                <div class="d-flex justify-content-between mb-1 mt-2">
                                    <small class="text-muted">Communication</small>
                                    <small class="fw-bold">@fb.CommunicationScore/10</small>
                                </div>
                                <div class="progress" style="height:5px;border-radius:3px;">
                                    <div class="progress-bar bg-success" style="width:@(fb.CommunicationScore * 10)%"></div>
                                </div>

                                <div class="d-flex justify-content-between mb-1 mt-2">
                                    <small class="text-muted">Problem Solving</small>
                                    <small class="fw-bold">@fb.ProblemSolvingScore/10</small>
                                </div>
                                <div class="progress" style="height:5px;border-radius:3px;">
                                    <div class="progress-bar bg-warning" style="width:@(fb.ProblemSolvingScore * 10)%"></div>
                                </div>
                            </div>

                            <!-- Comments Preview -->
                            @if (!string.IsNullOrEmpty(fb.Comments))
                            {
                                <div class="bg-light rounded-3 p-2 mb-3">
                                    <small class="text-muted">
                                        <i class="bi bi-quote me-1"></i>
                                        @(fb.Comments.Length > 80 ? fb.Comments.Substring(0, 80) + "..." : fb.Comments)
                                    </small>
                                </div>
                            }

                            <!-- Footer -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <div class="text-muted small"><i class="bi bi-person me-1"></i>@(fb.Interviewer?.Name ?? "N/A")</div>
                                    <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@fb.CreatedAt.ToString("dd MMM yyyy")</div>
                                </div>
                                <a asp-action="Details" asp-route-id="@fb.FeedbackId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
