@model TalentTrack.Models.Candidate

@{
    ViewData["Title"] = "Edit Candidate";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-primary text-white p-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Candidate</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="CandidateId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-medium">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Rahul Sharma" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="e.g. rahul@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-medium">Contact No</label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g. 9876543210" type="tel" maxlength="10" pattern="[0-9]{10}" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Skills" class="form-label fw-medium">Key Skills</label>
                        <input asp-for="Skills" class="form-control" placeholder="e.g. C#, ASP.NET Core, SQL, React" />
                        <span asp-validation-for="Skills" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Experience" class="form-label fw-medium">Experience (Years)</label>
                        <input asp-for="Experience" type="number" min="0" max="50" class="form-control" placeholder="e.g. 3" />
                        <span asp-validation-for="Experience" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium"><i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>Update Resume PDF</label>
                        @if (!string.IsNullOrEmpty(Model.Resume) && Model.Resume.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-2">
                                <a href="@Model.Resume" target="_blank" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-file-pdf-fill me-1"></i> View Uploaded PDF Resume
                                </a>
                            </div>
                        }
                        <input type="file" name="resumeFile" accept=".pdf" class="form-control" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Update Candidate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
