@model IEnumerable<TalentTrack.Models.Candidate>

@{
    ViewData["Title"] = "Candidates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Candidate Directory</h2>
        <p class="text-muted mb-0">View, manage, and inspect candidates and uploaded PDF resumes.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Apply" class="btn btn-outline-primary px-3">
            <i class="bi bi-send-fill me-1"></i> Apply for Job
        </a>
        <a asp-action="Create" class="btn btn-primary px-3">
            <i class="bi bi-person-plus-fill me-1"></i> Add Candidate
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Candidate Name</th>
                        <th>Email</th>
                        <th>Contact No</th>
                        <th>Skills</th>
                        <th>Experience</th>
                        <th>PDF Resume</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var candidate in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 36px; height: 36px;">
                                            @(string.IsNullOrEmpty(candidate.Name) ? "?" : candidate.Name.Substring(0, 1).ToUpper())
                                        </div>
                                        <span>@(candidate.Name ?? "N/A")</span>
                                    </div>
                                </td>
                                <td>@(candidate.Email ?? "N/A")</td>
                                <td>@(candidate.Phone ?? "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(candidate.Skills))
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">@candidate.Skills</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>@(candidate.Experience.HasValue ? $"{candidate.Experience} Years" : "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(candidate.Resume) && candidate.Resume.StartsWith("/uploads/"))
                                    {
                                        <a href="@candidate.Resume" target="_blank" class="btn btn-sm btn-outline-danger px-2 py-1">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> View PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">
                                            <i class="bi bi-file-earmark-text me-1"></i>@(candidate.Resume ?? "Not Uploaded")
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Profile" asp-route-id="@candidate.CandidateId" class="btn btn-sm btn-outline-info me-1" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@candidate.CandidateId" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@candidate.CandidateId" onclick="return confirm('Are you sure you want to delete this candidate?');" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-people display-6 d-block mb-2 text-secondary opacity-50"></i>
                                <span>No candidates found. Click <strong>Add Candidate</strong> to register a candidate.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>