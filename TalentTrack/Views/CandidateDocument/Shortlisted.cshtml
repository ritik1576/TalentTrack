@model IEnumerable<TalentTrack.Models.CandidateApplication>

@{
    ViewData["Title"] = "Document Verification";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
        <i class="bi bi-arrow-left fs-5"></i>
        <span>Back</span>
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Background Verification Portal</h2>
        <p class="text-muted mb-0">Review verification documents and manage background check statuses for accepted candidates.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-light border-0 py-3 ps-4">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-shield-check-fill text-success me-2"></i>Active Onboarding Verification Pipeline
        </h5>
        <small class="text-muted">Review uploaded documents and manage background check statuses.</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Candidate Name</th>
                        <th>Applied Job / Position</th>
                        <th>Application ID</th>
                        <th>Background Verification</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-2 fw-bold shadow-sm" style="width: 36px; height: 36px; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); font-size: 0.95rem;">
                                            @(string.IsNullOrEmpty(app.Candidate?.Name) ? "?" : app.Candidate.Name.Substring(0, 1).ToUpper())
                                        </div>
                                        <span>@(app.Candidate?.Name ?? "N/A")</span>
                                    </div>
                                </td>
                                <td class="fw-medium">@(app.Job?.JobTitle ?? "N/A")</td>
                                <td class="text-muted">#@app.ApplicationId</td>
                                <td>
                                    @if (app.BackgroundVerificationStatus == "Verified")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            <i class="bi bi-patch-check-fill me-1"></i>Verified
                                        </span>
                                    }
                                    else if (app.BackgroundVerificationStatus == "In Review")
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>In Review
                                        </span>
                                    }
                                    else if (app.BackgroundVerificationStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">
                                            <i class="bi bi-clock-history me-1"></i>Pending
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Verify" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-primary px-3 rounded-3">
                                        <i class="bi bi-file-earmark-check me-1"></i> View Candidate
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-people display-6 d-block mb-2 text-secondary opacity-50"></i>
                                <span>No candidates currently in the verification pipeline.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
