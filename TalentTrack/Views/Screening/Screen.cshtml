@model TalentTrack.Models.DTOs.ScreeningViewModel

@{
    ViewData["Title"] = "Candidate Screening";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Candidate Screening</h2>
        <p class="text-muted mb-0">Evaluate candidate skills and experience for this position</p>
    </div>
    <a asp-controller="Screening" asp-action="Index" class="btn btn-outline-secondary px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<!-- Duplicate Detection Alert -->
@if (Model.HasPreviousScreening)
{
    <div class="alert alert-warning d-flex align-items-center rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
        <div class="fw-medium">This candidate has already been screened/interviewed previously.</div>
    </div>
}

<div class="row">
    <!-- Candidate Info Card -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-header bg-primary text-white p-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-person-fill me-2"></i>Candidate Info</h6>
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <div class="tt-profile-avatar mx-auto" style="background: var(--tt-gradient-primary);">
                        @(string.IsNullOrEmpty(Model.Candidate.Name) ? "?" : Model.Candidate.Name.Substring(0, 1).ToUpper())@(Model.Candidate.Name?.Length >= 2 ? Model.Candidate.Name.Substring(1, 1).ToUpper() : "")
                    </div>
                    <h6 class="fw-bold mt-2 mb-0">@(Model.Candidate.Name ?? "N/A")</h6>
                    <small class="text-muted">@(Model.Candidate.Email ?? "N/A")</small>
                </div>
                <hr>
                <div class="mb-2">
                    <div class="text-muted small">Phone</div>
                    <div class="fw-medium">@(Model.Candidate.Phone ?? "N/A")</div>
                </div>
                <div class="mb-2">
                    <div class="text-muted small">Overall Experience</div>
                    <div class="fw-medium">@(Model.Candidate.Experience.HasValue ? $"{Model.Candidate.Experience} Years" : "N/A")</div>
                </div>

                @if (Model.CandidateSkills.Any())
                {
                    <hr>
                    <div class="text-muted small mb-2">Candidate's Skills</div>
                    @foreach (var cs in Model.CandidateSkills)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-medium">@cs.SkillName</span>
                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1" style="font-size: 0.7rem;">@cs.ExperienceYears Yrs</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Screening Evaluation Form -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-header bg-primary text-white p-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clipboard2-check me-2"></i>Skill Evaluation — @(Model.Job.JobTitle)</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Screen" method="post">
                    <input type="hidden" name="applicationId" value="@Model.Application.ApplicationId" />

                    <!-- Job Info -->
                    <div class="mb-4 p-3 rounded-3" style="background: #F1F5F9;">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="text-muted small">Job Title</div>
                                <div class="fw-bold">@Model.Job.JobTitle</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Location</div>
                                <div class="fw-medium"><i class="bi bi-geo-alt me-1"></i>@Model.Job.Location</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Experience</div>
                                <div class="fw-medium">@Model.Job.Experience</div>
                            </div>
                        </div>
                    </div>

                    <!-- Skill Evaluation Table -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-uppercase text-muted mb-3" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                            Required Skills Evaluation
                        </h6>

                        @if (Model.SkillInputs.Any())
                        {
                            @for (int i = 0; i < Model.SkillInputs.Count; i++)
                            {
                                var skillInput = Model.SkillInputs[i];
                                var requiredSkill = Model.RequiredSkills.FirstOrDefault(rs => rs.SkillName == skillInput.SkillName);
                                var candidateSkill = Model.CandidateSkills.FirstOrDefault(cs => cs.SkillName == skillInput.SkillName);

                                <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded-3 border" id="skillRow_@i">
                                    <input type="hidden" name="SkillInputs[@i].SkillName" value="@skillInput.SkillName" />

                                    <div class="form-check" style="min-width: 28px;">
                                        <input class="form-check-input" type="checkbox" name="SkillInputs[@i].HasSkill"
                                               value="true" id="skill_@i"
                                               @(skillInput.HasSkill ? "checked" : "")
                                               onchange="toggleExpInput(@i)" />
                                    </div>

                                    <div class="flex-grow-1">
                                        <div class="fw-medium">@skillInput.SkillName</div>
                                        <small class="text-muted">
                                            Required: <span class="fw-bold text-primary">@(requiredSkill?.RequiredExperience ?? 0) Years</span>
                                            @if (candidateSkill != null)
                                            {
                                                <span class="ms-2">| Candidate claims: <span class="fw-bold text-success">@candidateSkill.ExperienceYears Years</span></span>
                                            }
                                        </small>
                                    </div>

                                    <div class="d-flex align-items-center gap-2" id="expContainer_@i">
                                        <input type="number" name="SkillInputs[@i].ExperienceYears"
                                               class="form-control form-control-sm" style="width: 80px;"
                                               min="0" max="30" value="@skillInput.ExperienceYears"
                                               id="expInput_@i"
                                               @(!skillInput.HasSkill ? "disabled" : "") />
                                        <span class="text-muted small">Years</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-gear display-6 d-block mb-2 text-secondary opacity-50"></i>
                                <span>No required skills defined for this job.</span>
                            </div>
                        }
                    </div>

                    <!-- Notes -->
                    <div class="mb-4">
                        <label for="notes" class="form-label fw-medium">Screening Notes</label>
                        <textarea name="Notes" id="notes" class="form-control" rows="3" placeholder="Add your screening notes here...">@Model.Notes</textarea>
                    </div>

                    <!-- Submit -->
                    <div class="d-flex justify-content-between">
                        <a asp-controller="Screening" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Complete Screening
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleExpInput(index) {
            const checkbox = document.getElementById('skill_' + index);
            const expInput = document.getElementById('expInput_' + index);
            const row = document.getElementById('skillRow_' + index);

            if (checkbox.checked) {
                expInput.disabled = false;
                row.style.borderColor = '#10B981';
                row.style.background = 'rgba(16, 185, 129, 0.04)';
            } else {
                expInput.disabled = true;
                expInput.value = 0;
                row.style.borderColor = '';
                row.style.background = '';
            }
        }
    </script>
}
