@model TalentTrack.Models.Job

@{
    ViewData["Title"] = "Edit Job";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white p-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Job Opening</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="JobId" />

                    <div class="mb-3">
                        <label asp-for="JobTitle" class="form-label fw-medium">Job Title</label>
                        <input asp-for="JobTitle" class="form-control" placeholder="e.g. Senior Software Engineer" required />
                        <span asp-validation-for="JobTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Skills" class="form-label fw-medium">Skills Required</label>
                        <input asp-for="Skills" class="form-control" placeholder="e.g. C#, ASP.NET Core, SQL" required />
                        <span asp-validation-for="Skills" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-medium">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Remote / Mumbai" required />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Experience" class="form-label fw-medium">Experience Required</label>
                        <input asp-for="Experience" class="form-control" placeholder="e.g. 3-5 Years" required />
                        <span asp-validation-for="Experience" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-medium">Job Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Brief job description..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-medium">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Open">Open</option>
                            <option value="Hiring">Hiring</option>
                            <option value="Closed">Closed</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Update Job</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
