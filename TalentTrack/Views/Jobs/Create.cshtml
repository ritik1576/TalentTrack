@model TalentTrack.Models.Job

@{
    ViewData["Title"] = "Post New Job";
}

<div class="container-fluid">

    <h2 class="fw-bold mb-4">Post New Job</h2>

    <div class="card shadow p-4">

        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label class="form-label">Job Title</label>
                <input asp-for="JobTitle" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Skills</label>
                <input asp-for="Skills" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Location</label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Experience</label>
                <input asp-for="Experience" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <input asp-for="Status" class="form-control" value="Active" />
            </div>

            <button type="submit" class="btn btn-primary">
                Save Job
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>

</div>