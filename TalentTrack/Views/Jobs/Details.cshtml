@model TalentTrack.Models.Job

@{
    ViewData["Title"] = "Job Details";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
        <i class="bi bi-arrow-left fs-5"></i>
        <span>Back</span>
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Job Details</h2>
        <p class="text-muted mb-0">Complete information about this job opening</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.JobId" class="btn btn-outline-primary px-3">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<!-- Job Info Card -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-primary text-white p-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-briefcase-fill me-2"></i>@Model.JobTitle</h5>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="text-uppercase text-muted fw-bold small mb-1">Location</div>
                <div class="fw-medium"><i class="bi bi-geo-alt me-1 text-primary"></i>@Model.Location</div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="text-uppercase text-muted fw-bold small mb-1">Experience</div>
                <div class="fw-medium">@Model.Experience</div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="text-uppercase text-muted fw-bold small mb-1">Status</div>
                @if (Model.Status == "Active" || Model.Status == "Open" || Model.Status == "Hiring")
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@Model.Status</span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">@Model.Status</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="mt-2">
                <div class="text-uppercase text-muted fw-bold small mb-1">Description</div>
                <p class="mb-0 text-secondary">@Model.Description</p>
            </div>
        }
    </div>
</div>

<!-- Required Skills Card -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="px-4 pt-4 pb-2">
            <h5 class="fw-bold mb-1"><i class="bi bi-gear-fill text-primary me-2"></i>Required Skills & Experience</h5>
            <p class="text-muted small mb-0">Skills and minimum experience required for this position</p>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Skill Name</th>
                        <th>Required Experience</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.JobSkills != null && Model.JobSkills.Any())
                    {
                        var index = 1;
                        @foreach (var skill in Model.JobSkills)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@(index++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="tt-icon-bubble tt-icon-primary" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            <i class="bi bi-code-slash"></i>
                                        </div>
                                        <span class="fw-medium">@skill.SkillName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                        @skill.RequiredExperience @(skill.RequiredExperience == 1 ? "Year" : "Years")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                <i class="bi bi-gear display-6 d-block mb-2 text-secondary opacity-50"></i>
                                <span>No specific skill requirements added.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
