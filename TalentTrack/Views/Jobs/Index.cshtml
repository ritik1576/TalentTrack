@model IEnumerable<TalentTrack.Models.Job>

@{
    ViewData["Title"] = "Jobs";
}

<div class="mb-3">
    <a href="javascript:history.back()" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 hover-opacity fw-medium">
        <i class="bi bi-arrow-left fs-5"></i>
        <span>Back</span>
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Job Openings</h2>
        <p class="text-muted mb-0">View and manage open positions across your organization</p>
    </div>
    <a asp-controller="Jobs" asp-action="Create" class="btn btn-primary px-3">
        <i class="bi bi-briefcase-fill me-1"></i> Post New Job
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Job Title</th>
                        <th>Skills</th>
                        <th>Experience</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">@item.JobTitle</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">@item.Skills</span>
                                </td>
                                <td>@item.Experience</td>
                                <td><i class="bi bi-geo-alt me-1 text-muted"></i>@item.Location</td>
                                <td>
                                    @if (item.Status == "Active" || item.Status == "Open" || item.Status == "Hiring")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">@item.Status</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-3">
                                        <a asp-action="Details" asp-route-id="@item.JobId" class="text-info text-decoration-none" title="View">
                                            <i class="bi bi-eye fs-5"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.JobId" class="text-primary text-decoration-none" title="Edit">
                                            <i class="bi bi-pencil fs-5"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.JobId" onclick="return confirm('Are you sure you want to delete this job?');" class="text-danger text-decoration-none" title="Delete">
                                            <i class="bi bi-trash fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-briefcase display-6 d-block mb-2 text-secondary opacity-50"></i>
                                <span>No job openings found. Click <strong>Post New Job</strong> to create one.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>